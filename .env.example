# Copy to .env.local and fill in. Never commit real secrets.
# Every variable is validated by src/config/env.ts.

# --- Public (inlined into the browser bundle at build time) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# One of: IRR, USD, EUR, AED
NEXT_PUBLIC_DEFAULT_CURRENCY=IRR

# --- Server only (optional until the owning module is implemented) ---
# PostgreSQL (catalog/inventory/commerce persistence via Drizzle).
# This value matches the throwaway credentials in docker-compose.yml
# (`docker compose up -d`). Development only - never reuse it elsewhere.
DATABASE_URL=postgresql://fashion:fashion_dev_only@localhost:5432/fashion_commerce
# Migrations and tests (optional). Use a separate owner role in production.
# MIGRATION_DATABASE_URL=postgresql://fashion:fashion_dev_only@localhost:5432/fashion_commerce
# Runtime role that receives DML-only grants from migrations.
# DB_APP_ROLE=fashion_app
# DATABASE_POOL_MAX=10
# Admin URL for `npm run test:db`; each test file creates and drops its own database.
# TEST_DATABASE_URL=postgresql://fashion:fashion_dev_only@localhost:5432/postgres
# Identity & access: at least 32 random characters
AUTH_SECRET=

# S3-compatible media storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- docker-compose.yml overrides (optional; read from a git-ignored .env) ---
# POSTGRES_USER=fashion
# POSTGRES_PASSWORD=fashion_dev_only
# POSTGRES_DB=fashion_commerce
# POSTGRES_PORT=5432
