{
  "name": "fashion-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:check": "tsx scripts/check-migrations.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts up",
    "db:status": "tsx scripts/db-migrate.ts status",
    "db:migrate:down": "tsx scripts/db-migrate.ts down",
    "check": "npm run lint && npm run typecheck && npm run test && npm run db:check && npm run build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
